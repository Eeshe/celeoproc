# Secrets only. Non-secret settings/messages live in the config/ directory
# (config/settings.json, config/messages.json), overridable via
# SETTINGS_PATH / MESSAGES_PATH.
DISCORD_BOT_TOKEN=TOKEN
PGHOST=localhost
PGPORT=5432
PGDATABASE=celeoproc
PGUSER=celeoproc
PGPASSWORD=password

# Optional, defaults to 10
DATABASE_POOL_SIZE=10
